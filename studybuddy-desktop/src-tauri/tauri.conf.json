{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "StudyBuddy",
  "version": "0.1.0",
  "identifier": "com.studybuddy.desktop",
  "build": {
    "frontendDist": "../frontend"
  },
  "app": {
    "windows": [
      {
        "title": "StudyBuddy",
        "width": 568,
        "height": 1020,
        "minWidth": 430,
        "minHeight": 700,
        "backgroundColor": "#10191c"
      }
    ],
    "withGlobalTauri": true,
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self' data:; img-src 'self' data:; script-src 'self'; connect-src 'self' ipc: http://ipc.localhost; object-src 'none'; base-uri 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"]
  }
}
